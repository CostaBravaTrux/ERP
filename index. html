function doLogin(){
  const cargo = document.getElementById('login-cargo').value;
  const pass  = document.getElementById('login-pass').value;
  const err   = document.getElementById('login-error');
  if(!cargo){err.style.display='block';err.textContent='Selecciona un cargo';return;}
  if(!PASSWORDS[cargo]||pass!==PASSWORDS[cargo]){
    err.style.display='block';err.textContent='❌ Cargo o contraseña incorrectos';return;
  }
  err.style.display='none';
  currentRole = cargo;
  const nombres = {administrador:'Administrador',cajero:'Cajero',cocinero:'Cocinero',mozo:'Mozo',rrhh:'RRHH'};
  currentUser = nombres[cargo]||cargo;
  document.getElementById('h-user-name').textContent = currentUser;
  document.getElementById('h-user-role').textContent = cargo.charAt(0).toUpperCase()+cargo.slice(1);
  document.getElementById('h-avatar-initials').textContent = currentUser.slice(0,2).toUpperCase();
