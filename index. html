function editarCelda(td){
  const original=td.textContent;
  const input=document.createElement('input');
  input.className='cell-edit-input';
  input.value=original;
  td.textContent='';td.appendChild(input);input.focus();
  const guardar=()=>{
    const nuevo=input.value||original;
    td.textContent=nuevo;
    if(nuevo!==original)toast('Cambio guardado ✓','success');
  };
  input.addEventListener('blur',guardar);
  input.addEventListener('keydown',e=>{if(e.key==='Enter')guardar();if(e.key==='Escape'){td.textContent=original;}});
}

