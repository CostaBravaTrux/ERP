function emitirComprobante(){
  const tipo=document.getElementById('nf-tipo').value;
  const cliente=document.getElementById('nf-cliente').value||'Consumidor final';
  const ruc=document.getElementById('nf-ruc').value;
  const fecha=document.getElementById('nf-fecha').value||new Date().toISOString().split('T')[0];
  const totalText=document.getElementById('nf-total').textContent;
  const total=parseFloat(totalText.replace('S/ ',''))||0;
  if(total===0){toast('Agrega al menos un ítem','error');return;}
  const serie=tipo.includes('Factura')?'F001':'B001';
  const num=facturaCounter[serie]++;
  const id=`${serie}-${String(num).padStart(5,'0')}`;
  let items=[];
  document.querySelectorAll('#nf-items tr').forEach(tr=>{
    const inputs=tr.querySelectorAll('input');
    if(inputs.length>=2)items.push(inputs[0].value);
  });
  const subtotal=+(total/1.18).toFixed(2);
  const igv=+(total-subtotal).toFixed(2);
  const f={id,tipo:tipo.includes('Factura')?'Factura':'Boleta',fecha,cliente,ruc,desc:items.join(', '),subtotal,igv,total,estado:'pendiente'};
  FACTURAS.unshift(f);
  closeModal('modal-nueva-factura');
  document.getElementById('nf-items').innerHTML='';
  calcTotalFactura();
  renderFacturasTable();
  actualizarKPIsDashboard();
  // Mostrar comprobante emitido
  const boletaEl=document.getElementById('boleta-auto-content');
  if(boletaEl)boletaEl.innerHTML=generarHTMLFactura(f);
  setTimeout(()=>openModal('modal-boleta-auto'),200);
  toast(`${f.tipo} ${id} emitida y guardada ✓`,'success');
  // Limpiar form
  ['nf-cliente','nf-ruc','nf-direccion','nf-obs'].forEach(fid=>{const el=document.getElementById(fid);if(el)el.value='';});
}
