function registrarMovimientoCaja(concepto, monto, tipo, detalle){
  const hora=new Date().toLocaleTimeString('es-PE',{hour:'2-digit',minute:'2-digit'});
  const tbody=document.getElementById('caja-movimientos');
  if(tbody){
    const tr=document.createElement('tr');
    const color=tipo==='Ingreso'?'var(--green)':'var(--red)';
    const signo=tipo==='Ingreso'?'+ ':'- ';
    tr.innerHTML=`<td>${hora}</td><td class="td-bold">${concepto}</td><td>${detalle||''}</td><td><span class="badge ${tipo==='Ingreso'?'badge-green':'badge-red'}">${tipo}</span></td><td class="td-right td-bold" style="color:${color};">${signo}S/ ${parseFloat(monto).toFixed(2)}</td>`;
    tbody.insertBefore(tr,tbody.firstChild.nextSibling||tbody.firstChild);
  }
  // Actualizar saldo en caja
  actualizarSaldoCaja();
}
function actualizarSaldoCaja(){
  const tbody=document.getElementById('caja-movimientos');
  if(!tbody)return;
  let ingresos=300,egresos=0; // apertura base
  tbody.querySelectorAll('tr').forEach(tr=>{
    const cells=tr.querySelectorAll('td');
    if(cells.length>=5){
      const tipo=cells[3]?.textContent?.trim();
      const montoTxt=cells[4]?.textContent||'0';
      const monto=parseFloat(montoTxt.replace(/[^0-9.]/g,''))||0;
      if(tipo==='Ingreso')ingresos+=monto;
      else if(tipo==='Egreso')egresos+=monto;
    }
  });
  const saldo=ingresos-egresos;
  const elI=document.getElementById('caja-ingresos'),elE=document.getElementById('caja-egresos'),elS=document.getElementById('caja-saldo');
  if(elI)elI.textContent='S/ '+ingresos.toFixed(2);
  if(elE)elE.textContent='S/ '+egresos.toFixed(2);
  if(elS)elS.textContent='S/ '+saldo.toFixed(2);
}
