  if(tipo==='tangible'){data=ACTIVOS_T;titulo='Bienes Tangibles — Equipos, Mobiliario y Utensilios (35 ítems)';total=75260;count=35;}
  else if(tipo==='intangible'){data=ACTIVOS_I;titulo='Bienes Intangibles — Permisos, Licencias y Marketing Digital (15 ítems)';total=14335;count=15;}
  else if(tipo==='capital'){data=ACTIVOS_C;titulo='Capital de Trabajo — Insumos, Personal y Servicios Iniciales (20 ítems)';total=31490;count=20;}
  else{data=ACTIVOS_INFRA;titulo='Infraestructura — Inversión Mayor en Local y Equipamiento (11 ítems)';total=194100;count=11;}
