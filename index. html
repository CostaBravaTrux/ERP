      <div class="stat-mini"><span class="stat-mini-label">Margen bruto</span><span class="stat-mini-value" style="color:var(--green);font-size:16px;font-weight:800;">${m}%</span></div>
    </div>
    <div class="tbl-wrap"><table><thead><tr><th>#</th><th>Ingrediente</th><th class="td-center">Cant.</th><th class="td-center">Unidad</th><th class="td-center">Merma</th><th class="td-right">C.Unit.</th><th class="td-right">Costo Base</th><th class="td-right">Costo Real</th><th>Proveedor</th><th class="td-center">Stock</th></tr></thead><tbody>${rowsHTML}</tbody><tfoot><tr style="background:var(--ocean);color:#fff;"><td colspan="7" style="padding:10px 14px;font-weight:700;">COSTO TOTAL M.P.</td><td colspan="3" style="padding:10px 14px;font-weight:800;text-align:right;">S/ ${costoTotal.toFixed(2)}</td></tr></tfoot></table></div>
  </div>`;
}
function renderRecetasResumen(){
  const tbody=document.getElementById('recetas-resumen-tbody');if(!tbody)return;tbody.innerHTML='';
  const catBadge={ceviches:'badge-blue',mariscos:'badge-ocean',bebidas:'badge-green'};
  const catLabel={ceviches:'Ceviches',mariscos:'Mariscos',bebidas:'Bebidas'};
  Object.values(RECETAS_DATA).forEach(rec=>{
    const cT=costoReceta(rec);
    const m=((rec.precio-cT)/rec.precio*100).toFixed(1);
    const cat=rec.categoria||'mariscos';
    tbody.innerHTML+=`<tr><td class="td-bold">${rec.nombre}</td><td><span class="badge ${catBadge[cat]||'badge-ocean'}">${catLabel[cat]||cat}</span></td><td class="td-center">${rec.ingredientes.length}</td><td class="td-right">S/ ${(cT*0.85).toFixed(2)}</td><td class="td-center">10%</td><td class="td-right td-bold" style="color:var(--red);">S/ ${cT.toFixed(2)}</td><td class="td-right" style="color:var(--gold);">S/ ${rec.precio.toFixed(2)}</td><td class="td-right" style="color:var(--green);font-weight:700;">${m}%</td></tr>`;
  });
}
function agregarIngredienteReceta(){
  const tbody=document.getElementById('nr-ingredientes');if(!tbody)return;
  const tr=document.createElement('tr');
  tr.innerHTML=`<td><input type="text" class="inp" style="height:28px;" placeholder="Ingrediente"></td><td><input type="number" class="inp" style="height:28px;width:70px;" value="100"></td><td><select class="inp" style="height:28px;width:80px;"><option>g</option><option>kg</option><option>ml</option><option>unid</option></select></td><td><input type="number" class="inp" style="height:28px;width:60px;" value="10"></td><td><input type="number" class="inp" style="height:28px;width:90px;" step="0.001" value="0.010"></td><td><input type="text" class="inp" style="height:28px;" placeholder="Proveedor"></td><td><button class="btn btn-red btn-xs" onclick="this.closest('tr').remove()">✕</button></td>`;
  tbody.appendChild(tr);
}
function guardarReceta(){const p=document.getElementById('nr-plato')?.value;closeModal('modal-nueva-receta');toast('Receta de '+p+' guardada ✓','success');}

// ═══════════════════════════════════════════════════════════════
// BUSINESS INTELLIGENCE
// ═══════════════════════════════════════════════════════════════
function setBITab(tab,el){
  document.querySelectorAll('#bi-tabs .tab').forEach(t=>t.classList.remove('active'));
  if(el)el.classList.add('active');
  ['ventas','productos','costos','proyecciones'].forEach(t=>{const d=document.getElementById('bi-tab-'+t);if(d)d.style.display=t===tab?'':'none';});
  setTimeout(()=>initBICharts(tab),100);
}
function initBICharts(tab){
  if(tab==='ventas'||!tab){
    mkChart('chartBIVentasDia','bar',['Lun','Mar','Mié','Jue','Vie','Sáb','Dom'],[8200,9100,7800,10200,12500,15800,13200],'rgba(201,136,42,.7)');
    mkChart('chartBIVentasHora','line',['9h','10h','11h','12h','13h','14h','15h','16h','17h'],[1200,2800,4500,8200,9100,7300,5200,3100,1800],'rgba(37,99,235,.7)');
    mkPieChart('chartBIPagos',['Efectivo','Yape','Tarjeta','Plin'],[38,25,22,10]);
    mkPieChart('chartBICanales',['Salón','Delivery WA','Para llevar','Rappi'],[55,28,12,5]);
    mkChart('chartBIMensual','bar',['Ene','Feb','Mar','Abr','May','Jun'],[52000,58000,61000,65000,69000,71500],'rgba(5,150,105,.6)');
  }
  if(tab==='productos'){
    renderBIRanking();
    mkPieChart('chartBICategorias',['Ceviches','Mariscos','Bebidas','Combos'],[42,38,12,8]);
  }
  if(tab==='costos'){mkPieChart('chartBICostos',['M.Prima','Planilla','Indirectos','Gas','Delivery'],[35,22,12,8,5]);}
  if(tab==='proyecciones'){
    const base=74400;const proj=[1,2,3,4,5,6].map(i=>Math.round(base*(1+0.06*i)));
    mkChart('chartBIProyeccion','line',['Ago','Sep','Oct','Nov','Dic','Ene 2026'],proj,'rgba(201,136,42,.8)');
  }
}
function mkChart(id,type,labels,data,color){
  const cv=document.getElementById(id);if(!cv)return;
  if(cv._ci)cv._ci.destroy();
  cv._ci=new Chart(cv,{type,data:{labels,datasets:[{data,backgroundColor:color,borderColor:color.replace('.7','1').replace('.6','1').replace('.8','1'),fill:type==='line',tension:.4,borderRadius:type==='bar'?6:0,borderWidth:2,pointRadius:3,label:''}]},options:{responsive:true,maintainAspectRatio:true,plugins:{legend:{display:false}},scales:{y:{ticks:{callback:v=>'S/'+v.toLocaleString()}}}}});
}
function mkPieChart(id,labels,data){
  const cv=document.getElementById(id);if(!cv)return;
  if(cv._ci)cv._ci.destroy();
  cv._ci=new Chart(cv,{type:'doughnut',data:{labels,datasets:[{data,backgroundColor:['#C9882A','#2563EB','#059669','#7C3AED','#DC2626'],borderWidth:0}]},options:{responsive:true,maintainAspectRatio:true,plugins:{legend:{position:'right',labels:{font:{size:11},boxWidth:12}}}}});
}
function renderBIRanking(){
  const el=document.getElementById('bi-ranking-productos');if(!el)return;
  const r=[{n:'Ceviche Clásico',v:38,p:100},{n:'Ceviche Mixto',v:29,p:76},{n:'Arroz Mariscos',v:24,p:63},{n:'Jalea Mixta',v:21,p:55},{n:'Trio Marino',v:18,p:47}];
  el.innerHTML=r.map((x,i)=>`<div class="overview-item"><div class="ov-rank">${i+1}</div><div class="ov-name">${x.n}</div><div class="ov-bar"><div class="ov-bar-fill" style="width:${x.p}%"></div></div><div class="ov-val">${x.v} unid.</div></div>`).join('');
}
function refreshBI(){
  const active=document.querySelector('#bi-tabs .tab.active');
  const allTabs=document.querySelectorAll('#bi-tabs .tab');
  const tabNames=['ventas','productos','costos','proyecciones'];
  allTabs.forEach((t,i)=>{if(t===active)initBICharts(tabNames[i]);});
  toast('BI actualizado ✓','success');
}

// ═══════════════════════════════════════════════════════════════
// OVERRIDE goTo to init new pages
// ═══════════════════════════════════════════════════════════════
const _origGoTo=goTo;
function goTo(page){
  const perms=PERMISOS[currentRole]||[];
  if(!perms.includes(page)){toast('No tienes acceso a esta sección','error');return;}
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  const p=document.getElementById('page-'+page);if(p)p.classList.add('active');
  const n=document.getElementById('nav-'+page);if(n)n.classList.add('active');
  window.scrollTo(0,0);
  if(page==='pedidos')renderPedidosTable();
  if(page==='inventario'){renderInventario();actualizarKPIsInventario();}
  if(page==='facturacion')renderFacturasTable();
  if(page==='caja')setTimeout(()=>actualizarSaldoCaja(),100);
  if(page==='configuracion')initPasswordList();
  if(page==='ecommerce')setTimeout(()=>{setEcTab('catalogo',document.querySelector('#ec-tabs .tab'));},100);
  if(page==='produccion')setTimeout(()=>{setProdTab('platos',document.querySelector('#prod-tabs .tab'));},100);
  if(page==='recetas')setTimeout(()=>{renderRecetasResumen();},100);
  if(page==='bi')setTimeout(()=>{setBITab('ventas',document.querySelector('#bi-tabs .tab'));},100);
  if(page==='costeo')setTimeout(()=>{setCosteoTab('empleados',document.querySelector('#costeo-tabs .tab'));},100);
}

