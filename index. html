function aceptarPedidoOnline(num,total,cliente,items){
  // 1. Registrar en PEDIDOS
  const id='P-'+String(pedidoCounter++).padStart(4,'0');
  PEDIDOS.unshift({id,mesa:'Delivery',platos:items,total:parseFloat(total)||0,pago:'Por cobrar',estado:'pendiente',hora:new Date().toLocaleTimeString('es-PE',{hour:'2-digit',minute:'2-digit'}),cliente});
  // 2. Generar boleta automática
  const serie='B001';const num2=facturaCounter['B001']++;
  const boletaId=serie+'-'+String(num2).padStart(5,'0');
  const subtotal=+(parseFloat(total)/1.18).toFixed(2);const igv=+(parseFloat(total)-subtotal).toFixed(2);
  const f={id:boletaId,tipo:'Boleta',fecha:new Date().toISOString().split('T')[0],cliente,ruc:'',desc:items,subtotal,igv,total:parseFloat(total),estado:'pendiente'};
  FACTURAS.unshift(f);
  // 3. Actualizar fila en tabla online
  const row=document.getElementById('row-'+num);
  if(row)row.cells[6].innerHTML='<span class="badge badge-blue">Confirmado</span>';
  // 4. Mostrar boleta automática
  const boletaEl=document.getElementById('boleta-auto-content');
