// ── Helpers de costo (usan el maestro) ──
function costoIngrediente(ing){const ins=insumoById(ing.insumoId);if(!ins)return 0;return ins.costoBase*ing.cant*(1+(ing.merma||0)/100);}
function costoReceta(rec){return rec.ingredientes.reduce((s,ing)=>s+costoIngrediente(ing),0);}

// ── MOTOR DE DESCUENTO DE STOCK AL VENDER ──
// Recibe el array `pedido` del POS [{id,nombre,cant,...}] y descuenta insumos.
function descontarStockPorVenta(itemsVendidos){
  const faltantes=[];
  itemsVendidos.forEach(item=>{
    const rec=RECETAS_DATA[item.id];
    if(!rec)return; // plato sin receta configurada → no descuenta
    rec.ingredientes.forEach(ing=>{
      const ins=insumoById(ing.insumoId);if(!ins)return;
      const consumo=ing.cant*item.cant; // unidadBase × cantidad vendida
      ins.stockBase-=consumo;
      if(ins.stockBase<0){faltantes.push(ins.nombre);ins.stockBase=0;}
    });
  });
  // refrescar vistas si están montadas
  try{renderInventario();}catch(e){}
  try{actualizarKPIsInventario();}catch(e){}
  return faltantes;
}

// ── RENDER INVENTARIO DINÁMICO (categorizado) ──
let invFiltroActual='todos';
function estadoInsumo(ins){
  if(ins.stockBase<=0)return{badge:'badge-red',label:'⚠ Sin stock',color:'var(--red)'};
  if(ins.stockBase<ins.minBase*0.5)return{badge:'badge-red',label:'⚠ Crítico',color:'var(--red)'};
  if(ins.stockBase<ins.minBase)return{badge:'badge-yellow',label:'⚠ Bajo',color:'var(--yellow)'};
  return{badge:'badge-green',label:'✓ OK',color:'var(--green)'};
}
function fmtStock(ins){
  // muestra stock en unidad base, y equivalente en unidad de compra si aplica
  const n=ins.stockBase;
  const txt=(n%1===0?n:n.toFixed(1))+' '+ins.unidadBase;
  return txt;
}
function renderInventario(){
  const tbody=document.getElementById('inventario-tbody');if(!tbody)return;
  const data=invFiltroActual==='todos'?INSUMOS_DATA:INSUMOS_DATA.filter(i=>i.categoria===invFiltroActual);
  tbody.innerHTML='';
  data.forEach((ins,idx)=>{
    const est=estadoInsumo(ins);
    const valor=ins.stockBase*ins.costoBase;
    const cat=CAT_INSUMO[ins.categoria]||{label:ins.categoria,color:'badge-gray'};
    tbody.innerHTML+=`<tr>
      <td class="td-bold">${ins.id}</td>
      <td>${ins.nombre}</td>
      <td><span class="badge ${cat.color}">${cat.label}</span></td>
      <td style="font-size:11.5px;color:var(--text3);">${ins.compra} · S/ ${ins.pCompra.toFixed(2)}</td>
      <td class="td-center" style="color:${est.color};font-weight:700;">${fmtStock(ins)}</td>
      <td class="td-right">S/ ${ins.costoBase.toFixed(ins.costoBase<1?4:2)}</td>
      <td class="td-right td-bold">S/ ${valor.toLocaleString('es-PE',{maximumFractionDigits:0})}</td>
      <td>${ins.prov}</td>
      <td><span class="badge ${est.badge}">${est.label}</span></td>
      <td class="td-center"><button class="btn btn-gold btn-xs" onclick="abrirReabastecer(${ins.id})">+ Stock</button></td>
    </tr>`;
  });
  if(data.length===0)tbody.innerHTML='<tr><td colspan="10" style="text-align:center;padding:24px;color:var(--text3);">Sin insumos en esta categoría</td></tr>';
}
function filtrarInventario(cat,el){
  invFiltroActual=cat;
  document.querySelectorAll('#inv-tabs .tab').forEach(t=>t.classList.remove('active'));
  if(el)el.classList.add('active');
  const titulos={todos:'Todos los insumos',comida:'Comida',bebidas:'Bebidas',limpieza:'Limpieza',envases:'Envases / Operación',energia:'Energía / Gas'};
  const t=document.getElementById('inv-titulo');if(t)t.textContent='Inventario Detallado — '+(titulos[cat]||cat);
  renderInventario();
}
function actualizarKPIsInventario(){
  let critico=0,bajo=0,valor=0;
  INSUMOS_DATA.forEach(ins=>{
    const est=estadoInsumo(ins);
    if(est.label.includes('Crítico')||est.label.includes('Sin stock'))critico++;
    else if(est.label.includes('Bajo'))bajo++;
    valor+=ins.stockBase*ins.costoBase;
  });
  const eT=document.getElementById('kpi-ins-total'),eC=document.getElementById('kpi-ins-critico'),eB=document.getElementById('kpi-ins-bajo'),eV=document.getElementById('kpi-ins-valor');
  if(eT)eT.textContent=INSUMOS_DATA.length;
  if(eC)eC.textContent=critico;
  if(eB)eB.textContent=bajo;
  if(eV)eV.textContent='S/ '+valor.toLocaleString('es-PE',{maximumFractionDigits:0});
}

// ── REABASTECER STOCK (suma cantidad y actualiza precio) ──
let reabInsumoId=null;
function abrirReabastecer(id){
  const ins=insumoById(id);if(!ins)return;
  reabInsumoId=id;
  const valorActual=(ins.stockBase*ins.costoBase).toLocaleString('es-PE',{maximumFractionDigits:2});
  document.getElementById('reab-info').innerHTML=`<strong>${ins.nombre}</strong><br>Stock actual: <strong>${ins.stockBase} ${ins.unidadBase}</strong> · Costo unit: <strong>S/ ${ins.costoBase.toFixed(ins.costoBase<1?4:2)}/${ins.unidadBase}</strong> · Valor: <strong>S/ ${valorActual}</strong><br><span style="color:var(--text3);">Proveedor: ${ins.prov} · Se compra por ${ins.compra}</span>`;
  document.getElementById('reab-unidad').value=ins.unidadBase;
  document.getElementById('reab-unidad-lbl').textContent='Unidad ('+ins.unidadBase+')';
  document.getElementById('reab-cant').value='';
  document.getElementById('reab-precio').value='';
  document.getElementById('reab-precio').placeholder='actual: '+ins.costoBase;
  document.getElementById('reab-total').value='';
  document.getElementById('reab-preview').style.display='none';
  openModal('modal-reabastecer');
}
function calcReab(){
  const ins=insumoById(reabInsumoId);if(!ins)return;
  const cant=parseFloat(document.getElementById('reab-cant').value)||0;
  const precio=parseFloat(document.getElementById('reab-precio').value)||ins.costoBase;
  document.getElementById('reab-total').value='S/ '+(cant*precio).toFixed(2);
  if(cant>0){
    const nuevoStock=ins.stockBase+cant;
    const prev=document.getElementById('reab-preview');
    prev.style.display='block';
    prev.innerHTML=`Después del ingreso → Stock: <strong>${nuevoStock} ${ins.unidadBase}</strong> · Nuevo valor: <strong>S/ ${(nuevoStock*precio).toLocaleString('es-PE',{maximumFractionDigits:2})}</strong>`;
  }
}
function confirmarReabastecer(){
  const ins=insumoById(reabInsumoId);if(!ins){closeModal('modal-reabastecer');return;}
  const cant=parseFloat(document.getElementById('reab-cant').value)||0;
  if(cant<=0){toast('Ingresa una cantidad válida','error');return;}
  const precioInput=parseFloat(document.getElementById('reab-precio').value);
  ins.stockBase+=cant;
  if(!isNaN(precioInput)&&precioInput>0){ins.costoBase=precioInput;ins.pCompra=precioInput;}
  closeModal('modal-reabastecer');
  renderInventario();
  actualizarKPIsInventario();
  toast(`+${cant} ${ins.unidadBase} de ${ins.nombre} ✓`,'success');
}
