  document.getElementById('login-cargo').value='';
  document.getElementById('login-pass').value='';
}

// ─── AUTO-LOGIN si viene del catálogo ───
function tryAutoLogin(){
  try{
    // Opción 1: auto-login inyectado por catálogo (múltiples fuentes)
    var creds = window.__CB_AL || (typeof __AUTO_LOGIN!=='undefined' ? __AUTO_LOGIN : null) || window.__AUTO_LOGIN || null;
    if(creds && creds.cargo && creds.pass && PASSWORDS[creds.cargo] && creds.pass===PASSWORDS[creds.cargo]){
      var ls=document.getElementById('login-screen');
      if(ls){ls.style.display='none';ls.style.visibility='hidden';}
      window.__CB_AL=null; window.__AUTO_LOGIN=null;
      _loginDirect(creds.cargo);
      return;
    }
    // Opción 2: localStorage (mismo origen)
    var cargo=localStorage.getItem('cb_erp_cargo');
    var pass=localStorage.getItem('cb_erp_pass');
    var ts=parseInt(localStorage.getItem('cb_erp_ts')||'0');
    if(cargo && pass && (Date.now()-ts)<90000 && PASSWORDS[cargo] && pass===PASSWORDS[cargo]){
      localStorage.removeItem('cb_erp_cargo');
      localStorage.removeItem('cb_erp_pass');
      localStorage.removeItem('cb_erp_ts');
      var ls2=document.getElementById('login-screen');
      if(ls2){ls2.style.display='none';ls2.style.visibility='hidden';}
      _loginDirect(cargo);
    }
  }catch(e){}
}
function _loginDirect(cargo){
  var nombres={administrador:'Administrador',cajero:'Cajero',cocinero:'Cocinero',mozo:'Mozo',rrhh:'RRHH'};
