  setTimeout(initCharts,200);
  const firstPage = PERMISOS[cargo][0];
  goTo(firstPage);
  toast('Bienvenido, '+currentUser+' ✓','success');
}

function doLogout(){
  currentUser=null;currentRole=null;pedido=[];
