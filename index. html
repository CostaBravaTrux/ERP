function calcRowTotal(inp){
  const row=inp.closest('tr');
  const inputs=row.querySelectorAll('input[type="number"]');
  const cant=parseFloat(inputs[0].value)||0,precio=parseFloat(inputs[1].value)||0;
  row.querySelector('.row-total').textContent='S/ '+(cant*precio).toFixed(2);
  calcTotalFactura();
}
function calcTotalFactura(){
  let sub=0;
  document.querySelectorAll('#nf-items .row-total').forEach(c=>{sub+=parseFloat(c.textContent.replace('S/ ',''))||0;});
  const igv=sub*0.18,total=sub+igv;
  const ns=document.getElementById('nf-sub'),ni=document.getElementById('nf-igv'),nt=document.getElementById('nf-total');
  if(ns)ns.textContent='S/ '+sub.toFixed(2);if(ni)ni.textContent='S/ '+igv.toFixed(2);if(nt)nt.textContent='S/ '+total.toFixed(2);
}
