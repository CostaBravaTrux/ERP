function calcularCostoEmpleado(emp){
  const salario=parseFloat(emp.salario)||0,bonif=parseFloat(emp.bonif)||0,familiar=parseFloat(emp.familiar)||0;
  const tE=(parseFloat(document.getElementById('tasa-essalud')?.value)||9)/100;
  const tC=(parseFloat(document.getElementById('tasa-cts')?.value)||1)/12;
  const tG=(parseFloat(document.getElementById('tasa-gratifico')?.value)||2)/12;
  const dV=parseFloat(document.getElementById('tasa-vacaciones')?.value)||30;
  const hD=parseFloat(document.getElementById('horas-dia')?.value)||8;
  const dM=parseFloat(document.getElementById('dias-mes')?.value)||26;
  const bruta=salario+bonif+familiar;
  const essalud=bruta*tE,cts=bruta*tC,gratifico=bruta*tG,vacaciones=bruta/12*(dV/30);
  const costoMes=bruta+essalud+cts+gratifico+vacaciones;
  const costoAnual=costoMes*12,horasMes=hD*dM;
  const costoHora=horasMes>0?costoMes/horasMes:0,costoMinuto=costoHora/60;
  return{remuBruta:bruta,essalud,cts,gratifico,vacaciones,costoMes,costoAnual,costoHora,costoMinuto};
}
